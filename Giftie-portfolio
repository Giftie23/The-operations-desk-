<script>
  // Toolkit stories tray + tools grid share one data source
  const tools = [
    { label: "CapCut", detail: "Multi-track editing, keyframing, auto-caption sync, pacing for retention.",
      icon: '<path d="M23 7l-7 5 7 5V7zM14 5H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2z"/>' },
    { label: "InShot", detail: "Rapid mobile-first cuts and exports for fast-turnaround content.",
      icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-5-5L5 21"/>' },
    { label: "Canva", detail: "Brand kit architecture, grid and template libraries, carousel and bio design.",
      icon: '<circle cx="13.5" cy="6.5" r="2.5"/><circle cx="19" cy="17" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="M13.5 9v4M8.2 15.5l3-3M15.8 15.5l3-3"/>' },
    { label: "Notion", detail: "Editorial calendar builds, shared asset workflows, content OS design.",
      icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/>' },
    { label: "Meta Suite", detail: "Scheduling, publishing, and reach/interaction analytics across accounts.",
      icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3l-4 4-4-4"/>' },
    { label: "IG Insights", detail: "Keyword-first bio and caption optimization, DM-share-driven reach strategy.",
      icon: '<path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.1-3-3L3 17"/>' },
    { label: "Workspace", detail: "Scripting, shared documentation, and cross-team collaboration.",
      icon: '<path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16"/>' },
  ];

  const tray = document.getElementById('tray');
  tools.forEach(t => {
    const el = document.createElement('div');
    el.className = 'story';
    el.innerHTML = `<div class="ring"><div class="ring-inner"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${t.icon}</svg></div></div><div class="s-label">${t.label}</div>`;
    tray.appendChild(el);
  });

  const grid = document.getElementById('toolsGrid');
  tools.forEach(t => {
    const el = document.createElement('div');
    el.className = 'tool-card';
    el.innerHTML = `<div class="th"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${t.icon}</svg><h3>${t.label}</h3></div><p>${t.detail}</p>`;
    grid.appendChild(el);
  });

  // Scroll reveal for post cards
  const posts = document.querySelectorAll('[data-post]');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.15 });
  posts.forEach(p => io.observe(p));
  // Safety net: ensure visibility even if IO never fires (reduced motion, odd viewports, etc.)
  setTimeout(() => posts.forEach(p => p.classList.add('in')), 1200);
</script>

