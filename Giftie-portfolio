<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light only">
<meta name="supported-color-schemes" content="light">
<title>Giftie Obeten, Social Media Strategist & Content Operations Lead</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FAF8F3;
    --paper-2:#FAF8F3;
    --ink:#181B1E;
    --ink-soft:#40454A;
    --berry:#2C5F5A;
    --berry-soft:#3D7A73;
    --gold:#2C5F5A;
    --muted:#84898D;
    --line:#E3DFD5;
    --card:#FFFFFF;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{ scroll-behavior:smooth; color-scheme:light only; background:#FAF8F3; }
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Space Grotesk', sans-serif;
    overflow-x:hidden;
  }
  ::selection{ background:var(--berry); color:var(--paper); }

  .noise{
    position:fixed; inset:0; pointer-events:none; z-index:0; opacity:.035; mix-blend-mode:multiply;
    background-image: radial-gradient(circle at 1px 1px, #000 1px, transparent 0);
    background-size: 3px 3px;
  }

  a{ color:inherit; }

  .eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    letter-spacing:.16em;
    text-transform:uppercase;
    color:var(--berry);
  }

  /* ---------- NAV ---------- */
  nav{
    position:sticky; top:0; z-index:50;
    display:flex; justify-content:space-between; align-items:center;
    padding:22px 6vw;
    background:rgba(241,237,226,.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .logo{ font-family:'Fraunces', serif; font-weight:600; font-size:19px; letter-spacing:.01em; }
  nav .handle{ font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--muted); }

  /* ---------- HERO ---------- */
  .hero{
    position:relative; z-index:1;
    min-height:92vh;
    display:grid;
    grid-template-columns: 1.35fr 1fr;
    gap:40px;
    align-items:center;
    padding:6vw;
  }
  .hero-name{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-style:italic;
    font-size:clamp(52px, 8.4vw, 118px);
    line-height:.92;
    letter-spacing:-.01em;
    color:var(--ink);
  }
  .hero-name .accent{ color:var(--berry); font-style:normal; }
  .hero-title{
    margin-top:22px;
    font-size:clamp(18px,2vw,23px);
    font-weight:500;
    color:var(--ink-soft);
    max-width:520px;
  }
  .hero-loc{
    margin-top:14px;
    font-family:'IBM Plex Mono', monospace;
    font-size:13px;
    color:var(--muted);
  }
  .hero-stats{
    display:flex; flex-direction:column; gap:0;
    border-left:1px solid var(--line);
    padding-left:36px;
  }
  .stat{ padding:20px 0; border-bottom:1px solid var(--line); }
  .stat:last-child{ border-bottom:none; }
  .stat .num{ font-family:'Fraunces', serif; font-size:40px; font-weight:600; color:var(--berry); line-height:1; }
  .stat .label{ margin-top:6px; font-size:13.5px; color:var(--ink-soft); }

  /* ---------- STORIES TRAY (signature element) ---------- */
  .tray-wrap{
    position:relative; z-index:1;
    padding:26px 6vw 40px;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    background:var(--paper-2);
  }
  .tray-label{ margin-bottom:18px; }
  .tray{
    display:flex; gap:26px; overflow-x:auto; padding-bottom:6px;
    scrollbar-width:none;
  }
  .tray::-webkit-scrollbar{ display:none; }
  .story{
    flex:0 0 auto; width:84px; text-align:center; cursor:default;
  }
  .story .ring{
    width:74px; height:74px; border-radius:50%;
    padding:3px;
    background: conic-gradient(from 220deg, var(--gold), var(--berry-soft), var(--berry), var(--gold));
    display:flex; align-items:center; justify-content:center;
    transition:transform .25s ease;
  }
  .story:hover .ring{ transform:scale(1.08); }
  .story .ring-inner{
    width:100%; height:100%; border-radius:50%;
    background:var(--card);
    display:flex; align-items:center; justify-content:center;
  }
  .story svg{ width:28px; height:28px; stroke:var(--ink); }
  .story .s-label{ margin-top:9px; font-size:11.5px; font-weight:500; color:var(--ink-soft); }

  /* ---------- SECTION SHELL ---------- */
  section.block{ position:relative; z-index:1; padding:90px 6vw; }
  .section-head{ display:flex; align-items:baseline; gap:18px; margin-bottom:46px; }
  .section-head h2{
    font-family:'Fraunces', serif; font-weight:600; font-size:clamp(30px,3.4vw,44px);
  }
  .section-head .rule{ flex:1; height:1px; background:var(--line); }

  /* ---------- WHO I AM ---------- */
  .who-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:60px; }
  .who-copy p{ font-size:17px; line-height:1.75; color:var(--ink-soft); margin-bottom:20px; }
  .who-copy p:first-child::first-letter{
    font-family:'Fraunces', serif; font-size:56px; font-weight:600; color:var(--berry);
    float:left; line-height:.8; margin-right:10px; margin-top:6px;
  }
  .pillars{ display:flex; flex-direction:column; gap:14px; }
  .pill{
    display:flex; align-items:center; gap:14px;
    background:var(--card); border:1px solid var(--line); border-radius:14px;
    padding:16px 18px;
    font-size:14.5px; font-weight:500;
  }
  .pill .dot{ width:8px; height:8px; border-radius:50%; background:var(--gold); flex:0 0 auto; }

  /* ---------- EXPERIENCE (post-card style) ---------- */
  .post{
    background:var(--card); border:1px solid var(--line); border-radius:20px;
    overflow:hidden; margin-bottom:34px;
    opacity:0; transform:translateY(26px);
    transition:opacity .7s ease, transform .7s ease;
  }
  .post.in{ opacity:1; transform:translateY(0); }
  .post-top{
    display:flex; align-items:center; gap:14px;
    padding:20px 26px; border-bottom:1px solid var(--line);
  }
  .avatar{
    width:42px; height:42px; border-radius:50%;
    background:linear-gradient(135deg, var(--berry), var(--gold));
    display:flex; align-items:center; justify-content:center;
    color:var(--paper); font-family:'Fraunces',serif; font-weight:600; font-size:16px;
  }
  .post-top .who{ font-weight:600; font-size:15.5px; }
  .post-top .meta{ font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:var(--muted); margin-top:2px; }

  .post-goal{
    padding:34px 26px;
    background:linear-gradient(120deg, var(--berry) 0%, var(--berry-soft) 60%, var(--gold) 130%);
    color:var(--paper);
  }
  .post-goal .eyebrow-w{ font-family:'IBM Plex Mono',monospace; font-size:11.5px; letter-spacing:.16em; text-transform:uppercase; opacity:.85; margin-bottom:10px; }
  .post-goal p{ font-family:'Fraunces', serif; font-weight:500; font-style:italic; font-size:clamp(20px,2.2vw,27px); line-height:1.35; }

  .post-body{ padding:26px 26px 10px; }
  .post-row{ margin-bottom:20px; }
  .post-row .k{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--berry); margin-bottom:6px; }
  .post-row .v{ font-size:15px; line-height:1.65; color:var(--ink-soft); }

  .post-bottom{
    display:flex; align-items:center; gap:22px;
    padding:14px 26px 22px; color:var(--muted);
  }
  .post-bottom .ico{ display:flex; align-items:center; gap:7px; font-size:12.5px; }
  .post-bottom svg{ width:17px; height:17px; stroke:var(--muted); fill:none; }

  /* ---------- TOOLSET ---------- */
  .tools-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:22px; }
  .tool-card{
    background:var(--card); border:1px solid var(--line); border-radius:16px; padding:26px;
  }
  .tool-card .th{ display:flex; align-items:center; gap:12px; margin-bottom:12px; }
  .tool-card svg{ width:22px; height:22px; stroke:var(--berry); fill:none; }
  .tool-card h3{ font-family:'Fraunces', serif; font-weight:600; font-size:18px; }
  .tool-card p{ font-size:13.5px; color:var(--ink-soft); line-height:1.55; }

  /* ---------- EXPERTISE PILLS ---------- */
  .expertise-wrap{ display:flex; flex-wrap:wrap; gap:12px; }
  .expertise-wrap span{
    font-family:'IBM Plex Mono', monospace; font-size:12.5px;
    border:1px solid var(--berry); color:var(--berry);
    padding:9px 16px; border-radius:100px;
  }

  /* ---------- FOOTER ---------- */
  footer{
    position:relative; z-index:1;
    background:var(--ink); color:var(--paper);
    padding:90px 6vw 60px;
  }
  footer h2{ font-family:'Fraunces', serif; font-style:italic; font-weight:600; font-size:clamp(38px,5vw,64px); margin-bottom:40px; }
  .contact-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:60px; }
  .contact-btn{
    display:flex; align-items:center; gap:12px;
    border:1px solid rgba(241,237,226,.25); border-radius:14px;
    padding:18px 20px; font-size:14px; font-weight:500;
    color:var(--paper);
    transition:border-color .2s ease, background .2s ease;
  }
  .contact-btn:hover{ border-color:var(--gold); background:rgba(61,122,115,.14); }
  .contact-btn svg{ width:18px; height:18px; stroke:var(--paper); fill:none; flex:0 0 auto; }
  footer .fine{ font-family:'IBM Plex Mono', monospace; font-size:11.5px; color:rgba(250,248,243,.7); }

  @media (max-width:820px){
    .hero{ grid-template-columns:1fr; }
    .hero-stats{ border-left:none; border-top:1px solid var(--line); padding-left:0; padding-top:24px; flex-direction:row; flex-wrap:wrap; gap:24px; }
    .stat{ border-bottom:none; padding:0; flex:1 1 40%; }
    .who-grid{ grid-template-columns:1fr; gap:34px; }
    .tools-grid{ grid-template-columns:1fr 1fr; }
    .contact-grid{ grid-template-columns:1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce){
    .post{ transition:none; }
    .story .ring{ transition:none; }
  }
</style>
</head>
<body>
