<script>
// CONFETTI
const canvas=document.getElementById('confetti-canvas');
const ctx=canvas.getContext('2d');
let pieces=[];
function resize(){canvas.width=window.innerWidth;canvas.height=window.innerHeight;}
resize();window.addEventListener('resize',resize);
const cols=['#E8C4B8','#C9A96E','#F2A7B8','#D4B8E0','#7D4E57','#fff','#FDF6F0','#F0DDB8','#5C3640','#FADADD'];
const shapes=['circle','rect','star'];
function mkPiece(x){
  return{
    x,y:canvas.height*Math.random()*-0.3,
    r:Math.random()*7+3,
    color:cols[Math.floor(Math.random()*cols.length)],
    shape:shapes[Math.floor(Math.random()*shapes.length)],
    vx:(Math.random()-0.5)*10,vy:Math.random()*4+2,
    gravity:0.15+Math.random()*0.1,
    rotation:Math.random()*360,rotSpeed:(Math.random()-0.5)*10,
    life:1,decay:Math.random()*0.008+0.005,
    wobble:Math.random()*3,wobbleSpeed:Math.random()*0.1
  };
}
function launch(count){
  count=count||400;
  for(let i=0;i<count;i++){
    setTimeout(()=>{pieces.push(mkPiece(Math.random()*canvas.width));},i*6);
  }
}
function drawStar(c,r){
  c.beginPath();
  for(let i=0;i<5;i++){
    const a=((i*4*Math.PI)/5)-Math.PI/2;
    const ai=((i*4*Math.PI)/5+2*Math.PI/5)-Math.PI/2;
    i===0?c.moveTo(Math.cos(a)*r,Math.sin(a)*r):c.lineTo(Math.cos(a)*r,Math.sin(a)*r);
    c.lineTo(Math.cos(ai)*(r*0.4),Math.sin(ai)*(r*0.4));
  }
  c.closePath();c.fill();
}
function draw(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  pieces=pieces.filter(p=>p.life>0&&p.y<canvas.height+80);
  pieces.forEach(p=>{
    p.x+=p.vx+Math.sin(p.wobble)*p.wobbleSpeed;
    p.y+=p.vy;p.vy+=p.gravity;
    p.rotation+=p.rotSpeed;p.wobble+=p.wobbleSpeed;
    p.life-=p.decay;
    ctx.save();ctx.globalAlpha=Math.max(0,p.life);
    ctx.translate(p.x,p.y);ctx.rotate(p.rotation*Math.PI/180);
    ctx.fillStyle=p.color;
    if(p.shape==='circle'){ctx.beginPath();ctx.arc(0,0,p.r,0,Math.PI*2);ctx.fill();}
    else if(p.shape==='rect'){ctx.fillRect(-p.r,-p.r/2,p.r*2,p.r);}
    else{drawStar(ctx,p.r);}
    ctx.restore();
  });
  requestAnimationFrame(draw);
}
draw();

