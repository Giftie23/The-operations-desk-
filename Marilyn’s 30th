async function loadCheck(){
  try{const r=await window.storage.get(CKEY);if(r&&r.value)checked=JSON.parse(r.value);}catch(e){checked=[];}
  renderCheck();
}
async function saveCheck(){try{await window.storage.set(CKEY,JSON.stringify(checked));}catch(e){}}
function renderCheck(){
  const list=document.getElementById('check-list');
